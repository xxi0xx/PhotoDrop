# Copy to .env and set your own administrator password before starting Compose.
# Use 12 to 72 bytes. Single-quote values containing $ or # in .env files.
PHOTODROP_ADMIN_PASSWORD=
# Native administrator authentication: password (default), oidc, password+oidc.
# Password remains required except in oidc-only mode. No forward-auth proxy needed.
PHOTODROP_ADMIN_AUTH=password
# OIDC modes require BASE_URL and all issuer/client fields plus at least one allowlist.
# HTTPS normally; HTTP is accepted only for localhost/loopback development.
# Preserve the issuer's exact path/trailing slash, e.g. Authentik application issuer.
PHOTODROP_OIDC_ISSUER=
PHOTODROP_OIDC_CLIENT_ID=
PHOTODROP_OIDC_CLIENT_SECRET=
# Comma-separated exact subjects/groups. Either matching allowlist authorizes admin.
PHOTODROP_OIDC_ALLOWED_SUBJECTS=
PHOTODROP_OIDC_ALLOWED_GROUPS=
PHOTODROP_OIDC_GROUPS_CLAIM=groups
# Space-separated OAuth scopes; openid is always included. No offline_access needed.
PHOTODROP_OIDC_SCOPES=openid profile email
# Compose-only image override. Leave unset for source builds. For a published release:
# PHOTODROP_IMAGE=ghcr.io/xxi0xx/photodrop:1.1.0
# Set the external HTTPS origin when deployed behind TLS; leave empty locally.
PHOTODROP_BASE_URL=
# Maximum bytes per photo or video (50 MiB by default).
PHOTODROP_MAX_FILE_SIZE=52428800
# Temporary anonymous grants; limits include completed and pending assets.
PHOTODROP_UPLOAD_SESSION_TTL=2h
PHOTODROP_UPLOAD_SESSION_MAX_ASSETS=100
PHOTODROP_UPLOAD_SESSION_MAX_BYTES=5368709120
# Optional Turnstile: configure both keys and BASE_URL, or leave both empty.
PHOTODROP_TURNSTILE_SITE_KEY=
PHOTODROP_TURNSTILE_SECRET_KEY=
# Trust no forwarded headers by default. Only list administrator-controlled proxies.
PHOTODROP_TRUSTED_PROXY_CIDRS=
# Token-bucket defaults are documented in docs/security.md; scale all rates together.
PHOTODROP_RATE_LIMIT_MULTIPLIER=1
PHOTODROP_RATE_LIMIT_DISABLED=false
# New uploads use local disk unless explicitly changed to s3.
PHOTODROP_STORAGE_PROVIDER=local
# Required stable destination name for S3; local uses built-in local-default.
PHOTODROP_STORAGE_BACKEND_KEY=
# Optional S3 backend; retain these settings when local mode has historical S3 assets.
PHOTODROP_S3_BUCKET=
PHOTODROP_S3_REGION=auto
PHOTODROP_S3_ENDPOINT=
PHOTODROP_S3_ACCESS_KEY_ID=
PHOTODROP_S3_SECRET_ACCESS_KEY=
PHOTODROP_S3_SESSION_TOKEN=
PHOTODROP_S3_PATH_STYLE=false
PHOTODROP_S3_PREFIX=photodrop/
PHOTODROP_S3_PRESIGN_TTL=10m
# Optional Immich: named keys are forwarded through a deployment overlay.
# See docs/export-immich.md; normal compose.yml remains unchanged.
# PHOTODROP_IMMICH_TARGET=home
# PHOTODROP_IMMICH_TARGETS=home
# PHOTODROP_IMMICH_HOME_URL=https://photos.example.com
# Optional browser origin; may differ from the internal API URL above.
# PHOTODROP_IMMICH_HOME_PUBLIC_URL=https://photos.example.com
# PHOTODROP_IMMICH_HOME_API_KEY=
