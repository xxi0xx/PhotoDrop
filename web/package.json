{
  "name": "photodrop-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "precheck": "node -e \"require('node:fs').rmSync('.svelte-check', { recursive: true, force: true })\"",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings --tsgo",
    "build": "vite build",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/qrcode": "1.5.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "dependencies": {
    "qrcode": "1.5.4"
  }
}
