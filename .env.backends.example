# Copy to .env.backends, set real values privately, and use compose.backends.yml.
# Put PHOTODROP_STORAGE_PROVIDER and PHOTODROP_STORAGE_BACKEND_KEY in .env.
# Leave the ordinary PHOTODROP_S3_* bucket/credential fields empty when defining
# that destination here. Do not define the same backend in both syntaxes.
PHOTODROP_S3_BACKENDS=primary-r2,old-r2

PHOTODROP_S3_PRIMARY_R2_BUCKET=photos-new
PHOTODROP_S3_PRIMARY_R2_ENDPOINT=https://ACCOUNT.r2.cloudflarestorage.com
PHOTODROP_S3_PRIMARY_R2_REGION=auto
PHOTODROP_S3_PRIMARY_R2_PATH_STYLE=false
PHOTODROP_S3_PRIMARY_R2_PREFIX=photodrop/
PHOTODROP_S3_PRIMARY_R2_ACCESS_KEY_ID=replace-me
PHOTODROP_S3_PRIMARY_R2_SECRET_ACCESS_KEY=replace-me

PHOTODROP_S3_OLD_R2_BUCKET=photos-old
PHOTODROP_S3_OLD_R2_ENDPOINT=https://OLD_ACCOUNT.r2.cloudflarestorage.com
PHOTODROP_S3_OLD_R2_REGION=auto
PHOTODROP_S3_OLD_R2_PATH_STYLE=false
PHOTODROP_S3_OLD_R2_PREFIX=photodrop/
PHOTODROP_S3_OLD_R2_ACCESS_KEY_ID=replace-me
PHOTODROP_S3_OLD_R2_SECRET_ACCESS_KEY=replace-me
